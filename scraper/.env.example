# Get these at https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# topic | search | channel
TG_MODE=topic
TG_GROUP=mygroup          # username (no @) or numeric id for private groups
TG_TOPIC_ID=12            # mode=topic: first number after the group in a topic link
TG_SEARCH=#internship     # mode=search
TG_LIMIT=100
TG_PAGES=3                # mode=channel
# Optional: force a type when the topic is dedicated to one (e.g. scholarship)
TG_DEFAULT_TYPE=

# --- Email approval (use an APP PASSWORD, never your real password) ---
# Gmail: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_TO=

# Approved items are written where the website reads them
OUTPUT_FILE=../web/data/opportunities.json
